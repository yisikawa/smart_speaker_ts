node_modules/
dist/
dist-test/
# Qwen3-TTS などの検証用 venv（scripts/spike-qwen-tts.py が使う）
.venv-tts/
logs/*.log
logs/*.wav
logs/*.out
logs/*.err
logs/tts-spike/
models/*.bin
# sherpa-onnx のモデル（scripts/setup-sherpa.ps1 で取得）
models/sherpa-*/
models/*.tar.bz2
whisper.cpp/*.dll
whisper.cpp/*.exe
whisper.cpp/_cpu-backup/
*.tsbuildinfo
.DS_Store

# ユーザー設定（既定値は config/settings.default.toml）
config/settings.toml
# PATCH /api/config で保存する前の退避ファイル
config/settings.toml.bak

# Live2D の Cubism Core とモデルは各自取得（ライセンスのため再配布しない）
vendor/
live2d-models/
Live2DModels/

# 立ち絵などのユーザー素材（各自用意）
assets/avatar/*
!assets/avatar/.gitkeep

# TTS の参照音声（権利のある音声を各自用意。B 案の GPT-SoVITS などで使う）
assets/voices/

# HTTPS の証明書（scripts\setup-https.ps1 で生成。秘密鍵を含むためコミットしない）
certs/
