{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist-test",
    "rootDir": ".",
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "sourceMap": false
  },
  "include": [
    "src/backend/**/*",
    "src/shared/**/*",
    "src/frontend/AudioPlayer.ts",
    "src/frontend/MicLoop.ts",
    "tests/**/*"
  ],
  "exclude": ["node_modules", "dist", "dist-test"]
}
