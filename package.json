{
  "name": "smart_speaker_ts",
  "version": "0.2.0",
  "description": "Local AI voice assistant (TypeScript backend + frontend), inspired by Sumika/Smart Speaker",
  "main": "dist/backend/index.js",
  "scripts": {
    "clean": "node scripts/clean.js",
    "build": "npm run clean && tsc -p tsconfig.frontend.json && tsc -p tsconfig.json && node scripts/build.js",
    "start": "node dist/backend/index.js",
    "dev": "ts-node src/backend/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test \"dist-test/tests/*.test.js\"",
    "smoke": "node scripts/smoke.js"
  },
  "keywords": [
    "voice-assistant",
    "ollama",
    "voicevox",
    "whisper",
    "typescript"
  ],
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "toml": "^3.0.0",
    "ws": "^8.14.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "@types/ws": "^8.5.10",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.0"
  }
}
